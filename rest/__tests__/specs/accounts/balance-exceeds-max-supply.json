{
  "description": "Account api rejects an account.balance value larger than the maximum HBAR supply",
  "setup": {},
  "urls": [
    "/api/v1/accounts?account.balance=gt:5000000000000000001",
    "/api/v1/accounts?account.balance=gt:9000000000000000000"
  ],
  "responseStatus": 400,
  "responseJson": {
    "_status": {
      "messages": [
        {
          "message": "Invalid parameter: account.balance"
        }
      ]
    }
  }
}
