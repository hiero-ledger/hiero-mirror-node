{
  "name": "@hiero-ledger/mirror-rest",
  "version": "0.163.0-SNAPSHOT",
  "description": "Mirror Node REST API",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "generate-proto-js": "node scripts/generate-proto-js.mjs",
    "prebuild": "npm run generate-proto-js",
    "build": "node esbuild.config.js",
    "dev": "cross-env HIERO_MIRROR_REST_LOG_LEVEL=trace nodemon --import=extensionless/register server.js",
    "start": "npm run build && node buildDist/server.js",
    "pretest": "node --import=extensionless/register __tests__/integration/generator.js && npm run prebuild",
    "test": "cross-env NODE_NO_WARNINGS=1 node --import=extensionless/register --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "author": "Mirror Node Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@godaddy/terminus": "4.12.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-prometheus": "0.221.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "asn1js": "3.0.10",
    "basic-auth": "3.0.0",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-http-context": "2.0.1",
    "express-openapi-validator": "5.6.2",
    "extend": "3.0.2",
    "ioredis": "6.0.0",
    "js-yaml": "5.4.1",
    "json-bigint": "1.0.0",
    "lodash": "4.18.1",
    "negotiator": "1.1.0",
    "parse-duration": "2.1.8",
    "pg": "8.23.0",
    "pg-range": "1.1.2",
    "qs": "6.16.0",
    "quick-lru": "7.3.0",
    "rfc4648": "1.5.4",
    "sql-formatter": "15.8.2",
    "swagger-ui-express": "5.0.1",
    "tsscmp": "1.0.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@testcontainers/postgresql": "12.1.0",
    "cross-env": "10.1.0",
    "crypto-random-string": "6.0.0",
    "esbuild": "0.28.2",
    "extensionless": "2.0.6",
    "jest": "30.5.0",
    "jest-extended": "7.0.0",
    "jest-junit": "17.0.0",
    "nodemon": "3.1.14",
    "pg-format": "1.0.4",
    "pgsql-parser": "18.2.6",
    "sinon": "22.1.0",
    "supertest": "7.2.2",
    "tar": "7.5.22"
  },
  "peerDependencies": {
    "ansi-regex": "6.3.0",
    "ansi-styles": "7.0.0",
    "chalk": "6.0.0",
    "debug": "4.4.3",
    "is-arrayish": "0.3.4",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.1"
  },
  "jest-junit": {
    "outputDirectory": "build/test-results/test",
    "outputName": "TEST-jest.xml"
  },
  "baseUrlPath": "/api/v1",
  "overrides": {
    "baseline-browser-mapping": "2.11.20",
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.3",
    "form-data": "4.0.6",
    "glob": "13.0.6",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "5.4.1"
    },
    "js-yaml": "5.4.1",
    "multer": "2.3.0",
    "path-to-regexp": "8.4.2",
    "protobufjs": "8.8.0",
    "test-exclude": "8.0.0"
  },
  "bundleDependencies": true,
  "allowScripts": {
    "@bufbuild/buf@1.72.0": true,
    "@parcel/watcher@2.6.0": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true,
    "cpu-features@0.0.10": true,
    "fsevents@2.3.3": true,
    "protobufjs@8.8.0": true,
    "ssh2@1.17.0": true,
    "unrs-resolver@1.12.2": true
  }
}
